# LLM Budget Gateway — environment reference
# Copy to .env and adjust (or export directly). Every GATEWAY_* var is
# read by pydantic-settings; dict/list fields are JSON.

# --- Core ---

# SQLite ledger path (the "sqlite:///" prefix is stripped to a filesystem path).
GATEWAY_DATABASE_URL=sqlite:///./gateway.db

# Budget config YAML (see examples/budgets.example.yaml for the shape).
# A missing file simply means no budget configs.
GATEWAY_BUDGET_CONFIG_PATH=budgets.yaml

# Static virtual key table: client API key -> key id (budget scope id).
GATEWAY_VIRTUAL_KEYS={"sk-test-123":"key1"}

# Optional: map request headers to user/team scopes.
GATEWAY_USER_HEADER_MAPPINGS={"X-User-Id":"user","X-Team-Id":"team"}

# Optional: override litellm baseline pricing per model (USD per 1M tokens).
GATEWAY_PRICING_OVERRIDES={"my-custom-model":{"input_cost_per_million":1.5,"output_cost_per_million":2.5}}

# Optional: automatic model fallback chains (see docs/fallback-chains.md).
GATEWAY_FALLBACK_CONFIGS=[{"model":"gpt-4o","chain":["gpt-3.5-turbo"],"on":["rate_limit","server_error","timeout"],"cooldown_seconds":60}]

# Max seconds for the first upstream byte and each stream chunk (float).
GATEWAY_PROVIDER_TIMEOUT=60.0

# --- Upstream provider credentials (LiteLLM convention) ---
# Provider credentials come from the gateway process environment, never
# from client requests. Set whichever your provider needs, e.g.:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
